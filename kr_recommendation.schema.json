{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iacp.dvo.ru/schemas/kr_recommendation.schema.json",
  "title": "Клиническая рекомендация МЗ РФ — модель тезисов и доказательств",
  "description": "Двухуровневая схема для автоматического формирования текста КР МЗ РФ из научных статей. Уровень 1 — evidence_unit (доказательство, извлечённое из статьи, расширение триплета). Уровень 2 — recommendation_thesis (тезис-рекомендация, агрегирующий доказательства). Соответствует приказу Минздрава России от 28.02.2019 № 103н (ред. от 28.09.2023).",
  "type": "object",
  "required": ["kr_meta", "evidence_units", "recommendation_theses"],
  "additionalProperties": false,

  "properties": {
    "kr_meta": { "$ref": "#/$defs/kr_meta" },
    "evidence_units": {
      "type": "array",
      "description": "Атомы-доказательства, извлечённые из научных статей.",
      "items": { "$ref": "#/$defs/evidence_unit" }
    },
    "recommendation_theses": {
      "type": "array",
      "description": "Тезисы-рекомендации, агрегирующие доказательства. Каждый становится строкой текста КР.",
      "items": { "$ref": "#/$defs/recommendation_thesis" }
    }
  },

  "$defs": {

    "kr_meta": {
      "type": "object",
      "description": "Метаданные клинической рекомендации (титульная часть).",
      "required": ["title", "year", "icd_codes", "age_category"],
      "additionalProperties": false,
      "properties": {
        "rubricator_id": { "type": "string", "description": "ID в Рубрикаторе КР МЗ РФ, напр. КР864" },
        "title": { "type": "string", "minLength": 5 },
        "year": { "type": "integer", "minimum": 2019, "maximum": 2100 },
        "revision_of": { "type": ["string", "null"], "description": "ID предыдущей версии при пересмотре" },
        "icd_codes": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-ZА-Я][0-9]{2}(\\.[0-9]{1,2})?$" },
          "minItems": 1
        },
        "icd_labels": {
          "type": "object",
          "description": "Код МКБ → название из offline-среза kr_core/refs.",
          "additionalProperties": { "type": "string" }
        },
        "age_category": { "type": "string", "enum": ["adults", "children", "mixed"] },
        "developer_org": { "type": "string", "description": "Профессиональная НКО-разработчик" },
        "schema_version": { "type": "string", "default": "1.0" }
      }
    },

    "evidence_unit": {
      "type": "object",
      "description": "Доказательство из научной статьи. Расширение существующего триплета (subject/predicate/object + ~20 полей).",
      "required": ["id", "subject", "predicate", "object", "source", "udd_source", "verification_status"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "pattern": "^ev_[0-9A-Za-z_]+$" },

        "subject": { "type": "string", "minLength": 1 },
        "predicate": { "type": "string", "minLength": 1 },
        "object": { "type": "string", "minLength": 1 },
        "negation": { "type": "boolean", "default": false, "description": "Отрицательное доказательство (вмешательство НЕ эффективно)." },

        "source": { "$ref": "#/$defs/source" },

        "intervention_type": {
          "description": "Тип вмешательства доказательства. Определяет применяемую шкалу УДД. Должен совпадать с типом тезиса, к которому оно привязано.",
          "$ref": "#/$defs/intervention_type_enum"
        },
        "udd_source": {
          "description": "УДД, присвоенный ИСТОЧНИКУ по дизайну исследования (1=высший .. 5=низший) согласно выбранной шкале (см. scale_ref тезиса).",
          "$ref": "#/$defs/udd_enum"
        },

        "extraction_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "verification_status": { "type": "string", "enum": ["verified", "conflicted", "unverified"] },
        "verification_notes": { "type": "string" },
        "kr_section": { "$ref": "#/$defs/kr_section_enum" }
      }
    },

    "recommendation_thesis": {
      "type": "object",
      "description": "Тезис-рекомендация. Единица текста КР с УУР/УДД.",
      "required": [
        "id", "kr_section", "statement", "direction",
        "intervention", "evidence_refs", "udd", "uur", "grade_rationale", "provenance"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^rec_[0-9A-Za-z_]+$" },
        "kr_section": { "$ref": "#/$defs/kr_section_enum" },
        "subsection_title": { "type": "string" },

        "statement": {
          "type": "string",
          "minLength": 10,
          "description": "Канонический текст тезиса. Должен начинаться с strength_phrase."
        },
        "direction": {
          "type": "string",
          "enum": ["positive", "negative"],
          "description": "Положительный (рекомендовать) или отрицательный (не рекомендовать) тезис, согласно п. приказа 103н."
        },
        "strength_phrase": {
          "type": "string",
          "enum": [
            "Рекомендуется",
            "Рекомендуется рассмотреть возможность",
            "Не рекомендуется",
            "Не рекомендуется рассматривать"
          ],
          "description": "Детерминированно выводится из пары (direction, uur)."
        },

        "intervention": { "$ref": "#/$defs/intervention" },

        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "pattern": "^ev_[0-9A-Za-z_]+$" },
          "minItems": 1,
          "description": "Ссылки на id из evidence_units, обосновывающие тезис."
        },

        "evidence_backed_core": {
          "type": "string",
          "description": "Та часть тезиса, которая прямо подтверждается evidence_refs. Ядро рекомендации без экспертных надстроек."
        },
        "expert_additions": {
          "type": "array",
          "description": "Конкретные утверждения тезиса (пороги, сроки, организационные требования), которые НЕ выводятся напрямую из источников. Механизм отлова фабрикованных привязок: если число/условие приписано источнику, где его нет, оно попадает сюда с basis=expert_consensus.",
          "items": {
            "type": "object",
            "required": ["claim", "basis"],
            "additionalProperties": false,
            "properties": {
              "claim": { "type": "string", "description": "Конкретное добавочное утверждение (напр. «оптимум 6–8 ч для травм <24 ч»)." },
              "basis": {
                "type": "string",
                "enum": ["expert_consensus", "evidence+expert", "guideline_cross_ref"],
                "description": "Основание: expert_consensus — только экспертное мнение; evidence+expert — частично из источника; guideline_cross_ref — из другого документа/КР."
              },
              "refs": {
                "type": "array",
                "items": { "type": "string", "pattern": "^ev_[0-9A-Za-z_]+$" },
                "description": "Источники, если basis включает доказательства. Пусто для чистого expert_consensus."
              }
            }
          }
        },

        "udd": {
          "description": "Итоговый УДД тезиса — агрегат по evidence_refs (как правило, лучший УДД среди согласованных доказательств).",
          "$ref": "#/$defs/udd_enum"
        },
        "uur": {
          "description": "Итоговый УУР тезиса. НЕ выводится напрямую из УДД: учитывает качество, согласованность и клиническую значимость.",
          "$ref": "#/$defs/uur_enum"
        },
        "grade_rationale": {
          "type": "string",
          "minLength": 5,
          "description": "Обоснование присвоенных УДД/УУР. Обязательно для аудита."
        },

        "consensus": { "$ref": "#/$defs/consensus" },
        "quality_criterion": { "$ref": "#/$defs/quality_criterion" },

        "icd_codes": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-ZА-Я][0-9]{2}(\\.[0-9]{1,2})?$" }
        },

        "provenance": {
          "type": "string",
          "enum": ["auto", "auto+expert_review", "manual"],
          "description": "Происхождение тезиса. auto до экспертной валидации УУР."
        },
        "review_flags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Флаги, требующие внимания эксперта."
        }
      },

      "allOf": [
        {
          "$comment": "Согласованность direction и strength_phrase.",
          "if": { "properties": { "direction": { "const": "positive" } } },
          "then": { "properties": { "strength_phrase": { "enum": ["Рекомендуется", "Рекомендуется рассмотреть возможность"] } } }
        },
        {
          "if": { "properties": { "direction": { "const": "negative" } } },
          "then": { "properties": { "strength_phrase": { "enum": ["Не рекомендуется", "Не рекомендуется рассматривать"] } } }
        },
        {
          "$comment": "Конфликтующие доказательства не дают сильную рекомендацию A.",
          "if": { "required": ["consensus"], "properties": { "consensus": { "required": ["agreement"], "properties": { "agreement": { "const": "conflicting" } } } } },
          "then": { "properties": { "uur": { "enum": ["B", "C"] } } }
        }
      ]
    },

    "intervention": {
      "type": "object",
      "required": ["type", "scale_ref"],
      "additionalProperties": false,
      "properties": {
        "type": { "$ref": "#/$defs/intervention_type_enum" },
        "scale_ref": {
          "type": "string",
          "enum": ["udd_diagnostic", "udd_treatment"],
          "description": "Какую шкалу УДД применять. diagnostic -> udd_diagnostic; therapeutic/preventive/rehab -> udd_treatment."
        },
        "action": { "type": "string", "description": "Что делается (вмешательство)." },
        "target_population": { "type": "string", "description": "Целевая популяция (P в PICO)." },
        "comparator": { "type": ["string", "null"], "description": "Сравнение (C в PICO)." },
        "outcome": { "type": "string", "description": "Исход / цель (O в PICO)." },
        "mnn": { "type": ["string", "null"], "description": "Международное непатентованное наименование (для лекарств)." },
        "atc_code": { "type": ["string", "null"], "description": "Код АТХ (WHO ATC), напр. M01AB15." }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "diagnostic" } } },
          "then": { "properties": { "scale_ref": { "const": "udd_diagnostic" } } }
        },
        {
          "if": { "properties": { "type": { "enum": ["therapeutic", "preventive", "rehab"] } } },
          "then": { "properties": { "scale_ref": { "const": "udd_treatment" } } }
        }
      ]
    },

    "consensus": {
      "type": "object",
      "required": ["agreement"],
      "additionalProperties": false,
      "properties": {
        "agreement": {
          "type": "string",
          "enum": ["consistent", "mixed", "conflicting"],
          "description": "Согласованность доказательств между собой."
        },
        "conflicting_refs": {
          "type": "array",
          "items": { "type": "string", "pattern": "^ev_[0-9A-Za-z_]+$" },
          "description": "Пары/группы доказательств, противоречащих друг другу."
        }
      }
    },

    "quality_criterion": {
      "type": "object",
      "description": "Данные для строки таблицы «Критерии оценки качества медицинской помощи».",
      "required": ["is_criterion"],
      "additionalProperties": false,
      "properties": {
        "is_criterion": { "type": "boolean" },
        "criterion_text": {
          "type": ["string", "null"],
          "description": "Формулировка в прошедшем времени совершённого действия («Выполнена...», «Проведено...»). НЕ копия statement. null, если тезис не критерий."
        },
        "applicable_stage": { "type": "string", "enum": ["diagnosis", "treatment", "rehabilitation", "prevention"] },
        "measurable": { "type": "boolean", "description": "Измеримый/проверяемый критерий." },
        "auto_eligible": {
          "type": "boolean",
          "description": "Автоматически отобран в таблицу: uur in {A,B} И type in {diagnostic,therapeutic} И measurable=true."
        }
      },
      "allOf": [
        {
          "$comment": "Если is_criterion=true, нужна формулировка и стадия.",
          "if": { "properties": { "is_criterion": { "const": true } } },
          "then": { "required": ["criterion_text", "applicable_stage", "measurable"] }
        }
      ]
    },

    "source": {
      "type": "object",
      "description": "Библиографический источник доказательства.",
      "required": ["title", "study_design"],
      "additionalProperties": false,
      "properties": {
        "doi": { "type": "string" },
        "pmid": { "type": "string", "pattern": "^[0-9]+$" },
        "title": { "type": "string", "minLength": 3 },
        "authors": { "type": "array", "items": { "type": "string" } },
        "year": { "type": "integer", "minimum": 1900, "maximum": 2100 },
        "journal": { "type": "string" },
        "study_design": { "$ref": "#/$defs/study_design_enum" },
        "sample_size": { "type": ["integer", "null"], "minimum": 0 },
        "population": { "type": "string" }
      }
    },

    "intervention_type_enum": {
      "type": "string",
      "enum": ["diagnostic", "therapeutic", "preventive", "rehab"]
    },

    "study_design_enum": {
      "type": "string",
      "description": "Дизайн исследования-источника. Маппится в УДД через справочник udd_mapping (зависит от scale_ref).",
      "enum": [
        "meta_analysis_rct",
        "systematic_review_rct",
        "rct",
        "meta_analysis_diagnostic",
        "diagnostic_with_reference",
        "diagnostic_without_reference",
        "cohort",
        "case_control",
        "non_comparative",
        "case_series",
        "case_report",
        "expert_opinion"
      ]
    },

    "udd_enum": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Уровень достоверности доказательств: 1 — высший, 5 — мнение экспертов."
    },

    "uur_enum": {
      "type": "string",
      "enum": ["A", "B", "C"],
      "description": "Уровень убедительности рекомендаций: A — сильная, B — условная, C — слабая."
    },

    "kr_section_enum": {
      "type": "string",
      "description": "Раздел КР по типовой структуре приказа 103н.",
      "enum": [
        "1.1", "1.2", "1.3", "1.4", "1.5", "1.6",
        "2.1", "2.2", "2.3", "2.4", "2.5",
        "3.1", "3.2", "3.3",
        "4",
        "5",
        "6",
        "7"
      ]
    }
  }
}
