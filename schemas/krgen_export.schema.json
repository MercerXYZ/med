{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "krgen-export/1",
  "title": "KRGen — полный экспорт проекта клинической рекомендации",
  "description": "Документы, факты, группы фактов, противоречия с решениями, тезисы и собранная КР. Поле присутствует всегда; null — в источнике не указано или не определено. Выгрузка по kr_recommendation.schema.json делается отдельно.",
  "type": "object",
  "required": ["schema_version", "generated_at", "generator", "project", "documents", "evidence_cards", "groups",
               "conflicts", "recommendations", "quality_criteria", "kr", "expert_edits", "processing_report"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^krgen-export/1\\."},
    "generated_at": {"type": "string", "format": "date-time"},
    "generator": {
      "type": "object", "required": ["model", "judge_model", "settings"],
      "description": "Модель, версии промптов и параметры запуска.",
      "properties": {"model": {"type": "string"}, "judge_model": {"type": "string"}, "settings": {"type": "object"}}
    },
    "project": {
      "type": "object", "required": ["id", "title", "age_category", "icd_codes", "developer_org", "normative_basis"],
      "properties": {
        "id": {"type": "string"}, "title": {"type": "string"},
        "age_category": {"enum": ["adults", "children", "mixed"]},
        "icd_codes": {"type": "array", "items": {"type": "string", "pattern": "^[A-ZА-Я][0-9]{2}(\\.[0-9]{1,2})?$"}},
        "developer_org": {"type": "string"}, "normative_basis": {"type": "string"}
      }
    },
    "documents": {"type": "array", "items": {
      "type": "object",
      "required": ["id", "filename", "sha256", "n_pages", "processing_status", "status_detail", "duplicate_of", "bibliography"],
      "properties": {
        "id": {"type": "string", "pattern": "^doc_"}, "filename": {"type": "string"}, "sha256": {"type": "string"},
        "n_pages": {"type": "integer", "minimum": 0},
        "processing_status": {"enum": ["queued", "processing", "done", "done_empty", "partial", "error", "unsupported", "duplicate"]},
        "status_detail": {"type": ["string", "null"]},
        "duplicate_of": {"type": ["string", "null"]},
        "bibliography": {"type": "object", "description": "title, authors, year, journal, doi, pmid, study_design, design_evidence, sample_size, population — только из текста документа"}
      }}},
    "evidence_cards": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
    "groups": {"type": "array", "items": {"$ref": "#/$defs/group"}},
    "conflicts": {"type": "array", "items": {"$ref": "#/$defs/conflict"}},
    "recommendations": {"type": "array", "items": {"$ref": "#/$defs/thesis"}},
    "quality_criteria": {"type": "array", "items": {
      "type": "object", "required": ["id", "thesis_id", "criterion_text", "in_kr"],
      "properties": {
        "id": {"type": "string"}, "thesis_id": {"type": "string", "pattern": "^rec_"},
        "criterion_text": {"type": "string", "description": "Прошедшее время: «Выполнена…», «Проведено…»"},
        "applicable_stage": {"type": ["string", "null"]}, "auto_eligible": {"type": ["boolean", "null"]},
        "in_kr": {"type": "boolean", "description": "Входит в таблицу критериев КР"}
      }}},
    "kr": {"$ref": "#/$defs/kr"},
    "expert_edits": {"type": "array", "items": {
      "type": "object", "required": ["entity", "entity_id", "action", "ts"],
      "properties": {"entity": {"enum": ["card", "thesis", "conflict", "group", "project"]},
                     "entity_id": {"type": "string"}, "action": {"type": "string"}, "before": {}, "after": {},
                     "comment": {"type": ["string", "null"]}, "ts": {"type": "number"}}}},
    "processing_report": {
      "type": "object",
      "description": "Покрытие страниц, пропуски с причинами, ошибки, число запросов, токены, стоимость (эквивалент API)."
    }
  },
  "$defs": {
    "fact": {
      "type": "object",
      "required": ["id", "doc_id", "statement_ru", "claim_type", "polarity", "source_quote", "pdf_page",
                   "verification", "group_id", "conflict_ids", "excluded_by_conflict", "in_kr"],
      "properties": {
        "id": {"type": "string", "pattern": "^ev_"},
        "doc_id": {"type": "string"},
        "statement_ru": {"type": "string"},
        "claim_type": {"enum": ["source_recommendation", "study_finding", "background_fact", null]},
        "polarity": {"enum": ["positive", "negative", "conditional", "descriptive", null]},
        "negation": {"type": "boolean"},
        "population": {"type": ["string", "null"]},
        "age_group": {"enum": ["adults", "children", "mixed", "unspecified", null]},
        "intervention": {"type": ["string", "null"]}, "comparator": {"type": ["string", "null"]},
        "outcome": {"type": ["string", "null"]}, "conditions": {"type": ["string", "null"]},
        "dose": {"type": ["string", "null"]}, "timing": {"type": ["string", "null"]}, "thresholds": {"type": ["string", "null"]},
        "intervention_type": {"enum": ["diagnostic", "therapeutic", "preventive", "rehab", "organizational", "descriptive", null]},
        "kr_section": {"type": ["string", "null"]},
        "topic_relevance": {"enum": ["direct", "indirect", "none", null]},
        "secondary_citation": {"type": "boolean", "description": "Пересказ чужой работы — УДД статьи не присваивается"},
        "source_quote": {"type": "string", "description": "Дословная цитата на языке источника"},
        "pdf_page": {"type": ["integer", "null"], "minimum": 1, "description": "Порядковый номер страницы PDF (с 1), на которой найдена цитата"},
        "verification": {
          "type": "object", "required": ["status", "user_status", "checks", "issues"],
          "properties": {
            "status": {"enum": ["verified", "needs_review", "unverified", "extracted"]},
            "user_status": {"enum": ["confirmed", "rejected", null]},
            "quote_match": {"enum": ["exact", "fuzzy", "partial", "not_found", "too_short", null]},
            "quote_score": {"type": ["number", "null"]}, "quote_found_page": {"type": ["integer", "null"]},
            "checks": {"type": "array"}, "judge": {"type": ["object", "null"]},
            "issues": {"type": "array", "items": {"type": "string"}}
          }
        },
        "group_id": {"type": ["string", "null"]},
        "conflict_ids": {"type": "array", "items": {"type": "string"}},
        "excluded_by_conflict": {"type": "boolean", "description": "Не идёт в КР по решению (или отсутствию решения) по противоречию"},
        "in_kr": {"type": "boolean", "description": "Цитируется в собранной КР"},
        "origin": {"enum": ["auto", "manual"]},
        "edited_by_expert": {"type": "boolean"},
        "auto_value": {"type": ["object", "null"], "description": "Машинный результат без правок эксперта"},
        "pending_auto_update": {"type": "boolean"},
        "run_id": {"type": ["string", "null"]}
      }
    },
    "group": {
      "type": "object",
      "required": ["id", "section", "statement", "auto_statement", "edited_by_expert", "excluded", "card_ids", "kr_card_ids"],
      "properties": {
        "id": {"type": "string"},
        "section": {"type": "string"},
        "statement": {"type": "string", "description": "Формулировка группы с учётом правки эксперта"},
        "auto_statement": {"type": "string"},
        "edited_by_expert": {"type": "boolean"},
        "excluded": {"type": "boolean", "description": "Эксперт исключил группу из КР"},
        "card_ids": {"type": "array", "items": {"type": "string"}},
        "kr_card_ids": {"type": "array", "items": {"type": "string"}, "description": "Факты группы, идущие в КР"},
        "origin": {"type": "string"},
        "run_id": {"type": ["string", "null"]}
      }
    },
    "conflict": {
      "type": "object",
      "required": ["id", "section", "kind", "description", "side_a", "side_b", "decision", "decided_by", "reason", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^cf_"},
        "section": {"type": "string"},
        "kind": {"enum": ["direction", "numbers", "population", "other"]},
        "description": {"type": "string"},
        "side_a": {"type": "array", "items": {"type": "string"}},
        "side_b": {"type": "array", "items": {"type": "string"}},
        "decision": {"enum": ["keep_both", "prefer_a", "prefer_b", "exclude", null]},
        "decided_by": {"enum": ["auto", "expert", null]},
        "reason": {"type": ["string", "null"]},
        "status": {"enum": ["open", "resolved"]},
        "origin": {"type": "string"}
      }
    },
    "thesis": {
      "type": "object",
      "required": ["id", "section", "kind", "statement", "evidence_ids", "status", "provenance", "review_flags", "in_kr"],
      "properties": {
        "id": {"type": "string", "pattern": "^rec_"},
        "section": {"type": ["string", "null"]},
        "group_id": {"type": ["string", "null"]},
        "kind": {"enum": ["recommendation", "narrative"]},
        "statement": {"type": "string"},
        "strength_phrase": {"type": ["string", "null"]},
        "body": {"type": ["string", "null"]},
        "direction": {"enum": ["positive", "negative", null]},
        "udd": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
        "uur": {"enum": ["A", "B", "C", null]},
        "uur_preliminary": {"type": ["boolean", "null"]},
        "grade_rationale": {"type": ["string", "null"]},
        "evidence_ids": {"type": "array", "items": {"type": "string"}},
        "expert_additions": {"type": ["array", "null"]},
        "comment": {"type": ["string", "null"]},
        "quality_criterion": {"type": ["object", "null"]},
        "status": {"enum": ["draft", "approved", "rejected"]},
        "provenance": {"enum": ["auto", "auto+expert_review", "manual"]},
        "review_flags": {"type": "array", "items": {"type": "string"}},
        "orphan": {"type": "boolean"},
        "in_kr": {"type": "boolean"},
        "edited_by_expert": {"type": "boolean"},
        "auto_value": {"type": ["object", "null"]},
        "pending_auto_update": {"type": "boolean"}
      }
    },
    "kr": {
      "type": "object",
      "description": "Собранная КР по структуре приказа 103н (та же модель, что в Word и Markdown).",
      "required": ["title", "meta", "sections", "references", "criteria"],
      "properties": {
        "title": {"type": "string"},
        "meta": {"type": "object", "required": ["icd_codes", "age_category", "developer_org", "year"]},
        "sections": {"type": "array", "items": {
          "type": "object", "required": ["key", "title", "level", "items"],
          "properties": {
            "key": {"type": "string"}, "title": {"type": "string"}, "heading": {"type": "string"},
            "level": {"enum": [1, 2]},
            "items": {"type": "array", "items": {
              "type": "object", "required": ["type", "id", "text", "refs", "fact_ids"],
              "properties": {
                "type": {"enum": ["thesis", "text"]}, "id": {"type": ["string", "null"]}, "text": {"type": "string"},
                "phrase": {"type": "string"}, "body": {"type": "string"},
                "udd": {"type": ["integer", "null"]}, "uur": {"type": ["string", "null"]},
                "refs": {"type": "array", "items": {"type": "integer", "minimum": 1}},
                "fact_ids": {"type": "array", "items": {"type": "string"}}
              }}}
          }}},
        "references": {"type": "array", "items": {
          "type": "object", "required": ["n", "text", "fact_ids"],
          "properties": {"n": {"type": "integer", "minimum": 1}, "text": {"type": "string"},
                         "doc_id": {"type": "string"}, "fact_ids": {"type": "array", "items": {"type": "string"}}}}},
        "criteria": {"type": "array", "items": {
          "type": "object", "required": ["text"],
          "properties": {"text": {"type": "string"}, "thesis_id": {"type": "string"}}}}
      }
    }
  }
}
